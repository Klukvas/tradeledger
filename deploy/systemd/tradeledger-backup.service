[Unit]
Description=TradeLedger PostgreSQL backup and optional off-host copy
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=tradeledger
WorkingDirectory=/srv/tradeledger
Environment=NODE_ENV=production
EnvironmentFile=-/etc/tradeledger/backup.env
ExecStart=/usr/bin/node scripts/prod-backup.mjs
UMask=0077
NoNewPrivileges=true
