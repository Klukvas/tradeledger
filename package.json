{
  "name": "tradeledger",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "test": "vitest run",
    "typecheck": "npm run typecheck:client && npm run typecheck:server",
    "lint": "eslint . --max-warnings 0",
    "build": "npm run typecheck:client && vite build && npm run server:build",
    "test:e2e": "playwright test",
    "typecheck:client": "tsc --noEmit",
    "typecheck:server": "npm run typecheck --workspace server",
    "server:build": "npm run build --workspace server",
    "server:unit": "npm run test:unit --workspace server",
    "server:integration": "npm run test:integration --workspace server",
    "server:start": "npm run start --workspace server",
    "server:dev": "npm run dev --workspace server",
    "db:generate": "npm run db:generate --workspace server",
    "db:migrate": "npm run db:migrate --workspace server",
    "seed:demo": "node scripts/seed-demo.mjs",
    "seed:export": "node scripts/seed-export.mjs",
    "seed:test": "node --test scripts/seed-demo.test.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "workspaces": [
    "server"
  ],
  "engines": {
    "node": ">=24.15.0 <25"
  }
}
